{
  "name": "identrail-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run prerender:routes",
    "prerender:routes": "tsx ./scripts/prerender-routes.ts",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "perf:lighthouse": "lhci autorun --config=./lighthouserc.json",
    "perf:bundle": "vite build --mode production"
  },
  "dependencies": {
    "input-otp": "^1.4.2",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.16.0"
  },
  "devDependencies": {
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@emnapi/wasi-threads": "^1.2.1",
    "@lhci/cli": "0.15.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "tmp": "^0.2.4",
    "qs": "^6.15.2",
    "ws": "^8.21.0",
    "basic-ftp": "^5.3.1"
  }
}
