{
  "name": "identrail-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run check:vercel-toolchain",
    "build": "tsc -b && vite build && npm run prerender:routes",
    "check:vercel-toolchain": "node ./scripts/check-vercel-toolchain.mjs",
    "prerender:routes": "tsx ./scripts/prerender-routes.ts",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "perf:lighthouse": "lhci autorun --config=./lighthouserc.json",
    "perf:bundle": "vite build --mode production"
  },
  "dependencies": {
    "input-otp": "^1.4.2",
    "lucide-react": "^1.28.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.2",
    "@emnapi/runtime": "^1.11.2",
    "@emnapi/wasi-threads": "^2.0.1",
    "@lhci/cli": "0.15.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "tmp": "^0.2.4",
    "qs": "^6.15.2",
    "ws": "^8.21.0",
    "basic-ftp": "^5.3.1",
    "body-parser": "1.20.6",
    "brace-expansion": "^5.0.9",
    "js-yaml": "4.3.0",
    "minimatch": "^10.2.5"
  }
}
