{
  "name": "identrail-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run check:vercel-toolchain",
    "build": "tsc -b && vite build && npm run prerender:routes",
    "check:vercel-toolchain": "node ./scripts/check-vercel-toolchain.mjs",
    "prerender:routes": "tsx ./scripts/prerender-routes.ts",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "perf:lighthouse": "lhci autorun --config=./lighthouserc.json",
    "perf:bundle": "vite build --mode production"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.2",
    "@emnapi/runtime": "^1.11.2",
    "@emnapi/wasi-threads": "^2.1.0",
    "@lhci/cli": "0.15.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.0",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@puppeteer/browsers": "^3.2.0",
    "uuid": "^11.1.1",
    "tmp": "^0.2.4",
    "qs": "^6.16.0",
    "ws": "^8.21.0",
    "basic-ftp": "^5.3.1",
    "body-parser": "1.20.6",
    "brace-expansion": "^5.0.9",
    "js-yaml": "4.3.2",
    "minimatch": "^10.2.5",
    "nanoid": "^3.3.17"
  }
}
