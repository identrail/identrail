FROM node:26-bookworm-slim@sha256:2d49d876e96237d76de412761cf05dbfe5aee325cc4406a4d41d5824c5bb8beb AS builder
WORKDIR /web

COPY web/package*.json ./
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm config set fetch-retries 5 \
    && npm config set fetch-retry-factor 2 \
    && npm config set fetch-retry-mintimeout 20000 \
    && npm config set fetch-retry-maxtimeout 120000 \
    && npm ci --no-audit

COPY web ./

ARG VITE_IDENTRAIL_API_URL
ARG VITE_ALLOW_MANUAL_PRODUCT_SESSION
ARG VITE_FEATURE_CONNECTOR_AWS
ARG VITE_FEATURE_CONNECTOR_GITHUB_V2
ARG VITE_FEATURE_CONNECTOR_K8S
ARG VITE_FEATURE_ONBOARDING_WIZARD
ENV VITE_IDENTRAIL_API_URL=${VITE_IDENTRAIL_API_URL}
ENV VITE_ALLOW_MANUAL_PRODUCT_SESSION=${VITE_ALLOW_MANUAL_PRODUCT_SESSION}
ENV VITE_FEATURE_CONNECTOR_AWS=${VITE_FEATURE_CONNECTOR_AWS}
ENV VITE_FEATURE_CONNECTOR_GITHUB_V2=${VITE_FEATURE_CONNECTOR_GITHUB_V2}
ENV VITE_FEATURE_CONNECTOR_K8S=${VITE_FEATURE_CONNECTOR_K8S}
ENV VITE_FEATURE_ONBOARDING_WIZARD=${VITE_FEATURE_ONBOARDING_WIZARD}

RUN npm run build

FROM nginxinc/nginx-unprivileged:1.31-alpine@sha256:18d67281256ded39ff65e010ae4f831be18f19356f83c60bc546492c7eb6dd23
ARG NGINX_CONF=default.conf
COPY deploy/docker/nginx/${NGINX_CONF} /etc/nginx/conf.d/default.conf
COPY --from=builder /web/dist /usr/share/nginx/html

EXPOSE 8080
