namespace    = "identrail"
release_name = "identrail"

create_namespace         = true
create_kubernetes_secret = false
secret_name              = "identrail-secrets"

# For production, create identrail-secrets through external secret management.
# Setting create_kubernetes_secret=true stores secret_data in Terraform state.
secret_data = {}

chart_values = {
  api = {
    image = {
      repository = "ghcr.io/example/identrail-api"
      tag        = "v1.0.0"
      pullPolicy = "IfNotPresent"
    }
  }
  worker = {
    image = {
      repository = "ghcr.io/example/identrail-worker"
      tag        = "v1.0.0"
      pullPolicy = "IfNotPresent"
    }
  }
  config = {
    IDENTRAIL_PROVIDER = "aws"
    IDENTRAIL_AWS_SOURCE = "sdk"
    IDENTRAIL_K8S_SOURCE = "kubectl"
    IDENTRAIL_LOCK_BACKEND = "postgres"
    IDENTRAIL_LOCK_NAMESPACE = "identrail-prod"
  }
}
